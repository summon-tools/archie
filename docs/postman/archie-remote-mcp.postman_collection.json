    {
      "name": "Read Only Tools",
      "item": [
        {
          "name": "List Apps",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const apps = json.result && json.result.structuredContent && json.result.structuredContent.apps;",
                  "if (Array.isArray(apps) && apps.length > 0 && !pm.collectionVariables.get('archie_app_id')) {",
                  "  pm.collectionVariables.set('archie_app_id', String(apps[0].app_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"archie-list-apps\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"archie_list_apps\",\n    \"arguments\": {}\n  }\n}"
            },
            "url": {
              "raw": "{{archie_base_url}}/api/mcp"
            }
