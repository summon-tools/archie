{
  "info": {
    "_postman_id": "d2f6fd2b-cd46-4dfb-9fdc-archie-mcp-local",
    "name": "Archie Remote MCP",
    "description": "Reusable Postman requests for Archie's remote MCP JSON-RPC endpoint. Set collection variables before running requests; do not store real tokens in this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{archie_mcp_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('HTTP status is successful', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
          "});",
          "",
          "if (pm.response.code === 200 && pm.response.headers.get('content-type') && pm.response.headers.get('content-type').includes('application/json')) {",
          "  const json = pm.response.json();",
          "  pm.test('JSON-RPC response is valid', function () {",
          "    pm.expect(json.jsonrpc).to.eql('2.0');",
          "    pm.expect(json.error, json.error && json.error.message).to.be.undefined;",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "archie_base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "archie_mcp_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "archie_app_id",
      "value": "",
