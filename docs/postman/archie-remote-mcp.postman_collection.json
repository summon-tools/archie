        {
          "name": "List Tasks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const tasks = json.result && json.result.structuredContent && json.result.structuredContent.tasks;",
                  "if (Array.isArray(tasks) && tasks.length > 0) {",
                  "  const first = tasks[0];",
                  "  if (first.task_id && !pm.collectionVariables.get('archie_task_id')) pm.collectionVariables.set('archie_task_id', String(first.task_id));",
                  "  if (first.conversation_id && !pm.collectionVariables.get('archie_conversation_id')) pm.collectionVariables.set('archie_conversation_id', String(first.conversation_id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"archie-list-tasks\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"archie_list_tasks\",\n    \"arguments\": {\n      \"app_id\": {{archie_app_id}},\n      \"status\": \"all\",\n      \"limit\": 25\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{archie_base_url}}/api/mcp"
            }
