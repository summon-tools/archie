# ===== REQUIRED =====
AUTH_SECRET_KEY=          # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ===== OPTIONAL =====
PROJECTS_DIR=~/Projects   # Where your project repos live
CLAUDE_BIN=auto           # Path to claude binary, or "auto" to detect
HOST=127.0.0.1            # Use 0.0.0.0 for server/Docker
PORT=8080                 # Entry port (proxy)
# DATABASE_PATH=              # Absolute path to SQLite DB (default: <project_root>/data/dashboard.db)

# ===== PORT RANGES =====
# APP_PORT_START=3001        # First port for managed apps (3001, 3002, 3003...)
# PREVIEW_PORT_MIN=9001      # Preview server port range start
# PREVIEW_PORT_MAX=9050      # Preview server port range end
# WS_PORT=8081               # WebSocket server port (terminal & console)

# ===== DEPLOYMENT =====
ARCHIE_MODE=development  # "development" or "production"
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
FORCE_SECURE_COOKIES=false  # Set true if behind HTTPS reverse proxy

# ===== OPTIONAL: CLAUDE PERMISSIONS =====
CLAUDE_DANGEROUS_PERMISSIONS=false  # Set true to enable --dangerously-skip-permissions

# ===== OPTIONAL: CODEX SANDBOX =====
# RunPod/Docker/restricted Linux hosts may block Codex's inner Bubblewrap sandbox
# with "Failed RTM_NEWADDR". Set to "bypass" there and rely on the host sandbox.
CODEX_READ_ONLY_MODE=read-only
# CODEX_FULL_ACCESS_MODE=bypass      # Default for implementation runs
